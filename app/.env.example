# Copy to .env (local only). NEVER commit .env — it is gitignored.
# On Vercel, put these in Project Settings -> Environment Variables instead.
# Keys stay server-side; the browser never sees them.
#
# Provider pick: if MODEL_PROVIDER is set it wins.
# Otherwise auto-detect: GEMINI_API_KEY present -> gemini,
# META_API_KEY present -> meta, else mock (demo data).

MODEL_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
META_API_KEY=
META_MODEL_ID=
